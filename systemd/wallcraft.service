[Unit]
Description=WallCraft — Wallpaper Manager Daemon
Documentation=https://github.com/Majvad/wallcraft
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/wallcraft/wallcraft-daemon.py --config %C/wallcraft/config.toml --ui-dir /usr/local/lib/wallcraft/ui
ExecStop=/bin/kill -TERM $MAINPID
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%C/wallcraft %h/.cache/wallcraft %h/.local/state/wallcraft
PrivateTmp=true

# Environment
Environment=XDG_CONFIG_HOME=%C
Environment=XDG_CACHE_HOME=%h/.cache
Environment=XDG_STATE_HOME=%h/.local/state

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wallcraft

[Install]
WantedBy=graphical-session.target
