#!/usr/bin/env bash
# ============================================================
# WallCraft CLI — Command-line interface for WallCraft daemon
# ============================================================
set -euo pipefail

VERSION="0.1.0"
DAEMON_PORT="${WALLCRAFT_PORT:-9520}"
DAEMON_HOST="${WALLCRAFT_HOST:-127.0.0.1}"
DAEMON_URL="http://${DAEMON_HOST}:${DAEMON_PORT}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/wallcraft"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/wallcraft"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/wallcraft"

# Paths (check multiple locations)
LIB_DIR="/usr/local/lib/wallcraft"
DAEMON_SCRIPT="${LIB_DIR}/wallcraft-daemon.py"
DETECTOR_SCRIPT="${LIB_DIR}/smart_detector.py"
PID_FILE="${STATE_DIR}/wallcraft.pid"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

# ============================================================
# Helper Functions
# ============================================================

log_info() { echo -e "${GREEN}[INFO]${NC} $*"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $*"; }
log_error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

api_get() {
    curl -s --connect-timeout 2 "${DAEMON_URL}/api/$1" 2>/dev/null || echo '{"error":"daemon not reachable"}'
}

api_post() {
    local endpoint="$1"
    local data="$2"
    curl -s --connect-timeout 2 -X POST "${DAEMON_URL}/api/${endpoint}" \
        -H "Content-Type: application/json" \
        -d "$data" 2>/dev/null || echo '{"error":"daemon not reachable"}'
}

is_daemon_running() {
    # Check PID file
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE")
        if kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
    fi
    # Check if port is responding
    if curl -s --connect-timeout 1 "${DAEMON_URL}/api/status" >/dev/null 2>&1; then
        return 0
    fi
    return 1
}

ensure_dirs() {
    mkdir -p "$CONFIG_DIR" "$CACHE_DIR" "$STATE_DIR"
}

# ============================================================
# Commands
# ============================================================

cmd_start() {
    if is_daemon_running; then
        log_warn "Daemon is already running"
        return 0
    fi

    ensure_dirs

    local config_file="${CONFIG_DIR}/config.toml"
    
    if [ -f "$DAEMON_SCRIPT" ]; then
        nohup python3 "$DAEMON_SCRIPT" \
            --config "$config_file" \
            --port "$DAEMON_PORT" \
            --ui-dir "${LIB_DIR}/ui" \
            > "${STATE_DIR}/wallcraft.log" 2>&1 &
        echo $! > "$PID_FILE"
        log_info "Daemon started (PID: $(cat "$PID_FILE"))"
        log_info "Web UI: http://localhost:${DAEMON_PORT}"
    else
        log_error "Daemon script not found at $DAEMON_SCRIPT"
        log_info "Run 'sudo make install' or './install.sh' first"
        return 1
    fi
}

cmd_stop() {
    if ! is_daemon_running; then
        log_warn "Daemon is not running"
        return 0
    fi

    if [ -f "$PID_FILE" ]; then
        kill "$(cat "$PID_FILE")" 2>/dev/null || true
        rm -f "$PID_FILE"
    fi

    # Also kill by port
    local pid
    pid=$(lsof -ti:"$DAEMON_PORT" 2>/dev/null || true)
    if [ -n "$pid" ]; then
        kill "$pid" 2>/dev/null || true
    fi

    log_info "Daemon stopped"
}

cmd_restart() {
    cmd_stop
    sleep 1
    cmd_start
}

cmd_status() {
    echo -e "${BOLD}╔══════════════════════════════════════╗${NC}"
    echo -e "${BOLD}║      WallCraft v${VERSION}                 ║${NC}"
    echo -e "${BOLD}╚══════════════════════════════════════╝${NC}"
    echo ""

    if is_daemon_running; then
        echo -e "  Daemon:    ${GREEN}● Running${NC}"
        local status
        status=$(api_get "status")
        local backend
        backend=$(echo "$status" | python3 -c "import sys,json; print(json.load(sys.stdin).get('backend','unknown'))" 2>/dev/null || echo "unknown")
        local wp_count
        wp_count=$(echo "$status" | python3 -c "import sys,json; print(json.load(sys.stdin).get('wallpaper_count',0))" 2>/dev/null || echo "0")
        echo -e "  Backend:   ${CYAN}${backend}${NC}"
        echo -e "  Wallpapers: ${wp_count}"
    else
        echo -e "  Daemon:    ${RED}● Stopped${NC}"
        echo ""
        echo -e "  Run ${CYAN}wallcraft start${NC} to start the daemon"
    fi
    echo ""

    # Environment check
    echo -e "${BOLD}Environment:${NC}"
    [ -n "${WAYLAND_DISPLAY:-}" ] && echo -e "  Wayland:   ${GREEN}✓${NC}" || echo -e "  Wayland:   ${RED}✗${NC}"
    [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && echo -e "  Hyprland:  ${GREEN}✓${NC}" || echo -e "  Hyprland:  ${RED}✗${NC}"
    command -v nvidia-smi &>/dev/null && echo -e "  NVIDIA:    ${GREEN}✓${NC}" || echo -e "  NVIDIA:    ${RED}✗${NC}"
    echo ""
}

cmd_monitors() {
    echo -e "${BOLD}Connected Monitors:${NC}"
    echo ""
    
    # Method 1: Try hyprctl directly (most reliable)
    if command -v hyprctl &>/dev/null; then
        local hypr_output
        hypr_output=$(hyprctl monitors -j 2>/dev/null || echo "")
        
        if [ -n "$hypr_output" ] && [ "$hypr_output" != "[]" ]; then
            echo "$hypr_output" | python3 -c "
import sys, json
try:
    monitors = json.load(sys.stdin)
    if not monitors:
        print('  No monitors detected')
        sys.exit(0)
    for m in monitors:
        name = m.get('name', 'unknown')
        w = m.get('width', '?')
        h = m.get('height', '?')
        rr = m.get('refreshRate', '?')
        focused = '★' if m.get('focused') else ' '
        x = m.get('x', 0)
        y = m.get('y', 0)
        scale = m.get('scale', 1.0)
        print(f'  {focused} {name}')
        print(f'    Resolution: {w}x{h} @ {rr}Hz')
        print(f'    Position: {x}x{y}, Scale: {scale}')
        print()
except Exception as e:
    print(f'  Error parsing monitors: {e}')
" 2>/dev/null
            return
        fi
    fi
    
    # Method 2: Try API
    local result
    result=$(api_get "monitors")
    
    echo "$result" | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    monitors = data.get('monitors', [])
    if not monitors:
        print('  No monitors detected')
        print('  Try running: hyprctl monitors')
        sys.exit(0)
    for m in monitors:
        name = m.get('name', 'unknown')
        w = m.get('width', '?')
        h = m.get('height', '?')
        rr = m.get('refreshRate', '?')
        focused = '★' if m.get('focused') else ' '
        print(f'  {focused} {name}')
        print(f'    Resolution: {w}x{h} @ {rr}Hz')
        print()
except Exception as e:
    print(f'  Error: {e}')
" 2>/dev/null || log_error "Failed to parse monitor data"
}

cmd_set() {
    local monitor="${1:-}"
    local path="${2:-}"

    if [ -z "$monitor" ] || [ -z "$path" ]; then
        log_error "Usage: wallcraft set <monitor> <path>"
        log_info "Example: wallcraft set eDP-1 ~/Wallpapers/image.jpg"
        return 1
    fi

    # Resolve path
    path=$(realpath "$path" 2>/dev/null || echo "$path")

    if [ ! -f "$path" ]; then
        log_error "File not found: $path"
        return 1
    fi

    local result
    result=$(api_post "wallpaper/set" "{\"monitor\":\"$monitor\",\"path\":\"$path\"}")

    local success
    success=$(echo "$result" | python3 -c "import sys,json; print(json.load(sys.stdin).get('success',False))" 2>/dev/null || echo "False")

    if [ "$success" = "True" ]; then
        log_info "Wallpaper set: $monitor -> $(basename "$path")"
    else
        local error
        error=$(echo "$result" | python3 -c "import sys,json; print(json.load(sys.stdin).get('error','unknown'))" 2>/dev/null || echo "unknown")
        log_error "Failed: $error"
        return 1
    fi
}

cmd_next() {
    local monitor="${1:-}"
    local data="{}"
    [ -n "$monitor" ] && data="{\"monitor\":\"$monitor\"}"

    local result
    result=$(api_post "wallpaper/next" "$data")

    local success
    success=$(echo "$result" | python3 -c "import sys,json; print(json.load(sys.stdin).get('success',False))" 2>/dev/null || echo "False")

    if [ "$success" = "True" ]; then
        log_info "Switched to next wallpaper"
    else
        log_error "Failed to switch wallpaper"
        return 1
    fi
}

cmd_list() {
    local result
    result=$(api_get "wallpapers")

    echo -e "${BOLD}Wallpaper Library:${NC}"
    echo ""
    echo "$result" | python3 -c "
import sys, json, os
data = json.load(sys.stdin)
wallpapers = data.get('wallpapers', [])
if not wallpapers:
    print('  No wallpapers found')
    sys.exit(0)
for wp in wallpapers:
    name = wp.get('name', '?')
    path = wp.get('path', '?')
    wtype = wp.get('type', '?')
    size = wp.get('size', 0)
    size_mb = size / (1024*1024) if size else 0
    icon = '🎬' if wtype == 'video' else '🖼'
    print(f'  {icon} {name}')
    print(f'     {path} ({size_mb:.1f} MB)')
" 2>/dev/null || log_error "Failed to parse wallpaper data"
}

cmd_detect() {
    echo -e "${BOLD}Smart System Detection${NC}"
    echo ""

    if ! command -v python3 &>/dev/null; then
        log_error "Python3 is required for smart detection"
        return 1
    fi

    # Try to find smart_detector.py in multiple locations
    local detector_script=""
    
    # Location 1: Installed location
    if [ -f "$DETECTOR_SCRIPT" ]; then
        detector_script="$DETECTOR_SCRIPT"
    # Location 2: Development location
    elif [ -f "./backend/smart_detector.py" ]; then
        detector_script="./backend/smart_detector.py"
    # Location 3: Relative to this script
    elif [ -f "$(dirname "$0")/../backend/smart_detector.py" ]; then
        detector_script="$(dirname "$0")/../backend/smart_detector.py"
    fi

    if [ -z "$detector_script" ]; then
        log_error "Smart detector not found"
        log_info "Expected locations:"
        log_info "  - $DETECTOR_SCRIPT"
        log_info "  - ./backend/smart_detector.py"
        return 1
    fi

    python3 "$detector_script" 2>/dev/null | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    
    print('Distribution:')
    dist = data.get('distribution', {})
    print(f'  Name: {dist.get(\"pretty_name\", \"Unknown\")}')
    print(f'  Package Manager: {dist.get(\"package_manager\", \"unknown\")}')
    print()
    
    print('GPU:')
    gpu = data.get('gpu', {})
    print(f'  Vendor: {gpu.get(\"vendor\", \"unknown\")}')
    print(f'  Model: {gpu.get(\"model\", \"Unknown\")}')
    print(f'  VRAM: {gpu.get(\"vram\", \"N/A\")}')
    print(f'  Driver: {gpu.get(\"driver\", \"N/A\")}')
    print(f'  Acceleration: {gpu.get(\"acceleration_method\", \"none\")}')
    print(f'  CUDA: {\"✓\" if gpu.get(\"has_cuda\") else \"✗\"}')
    print(f'  VA-API: {\"✓\" if gpu.get(\"has_vaapi\") else \"✗\"}')
    print()
    
    print('Environment:')
    env = data.get('environment', {})
    print(f'  Compositor: {env.get(\"compositor\", \"Unknown\")}')
    print(f'  Wayland: {\"✓\" if env.get(\"is_wayland\") else \"✗\"}')
    print(f'  Hyprland: {\"✓\" if env.get(\"is_hyprland\") else \"✗\"}')
    print()
    
    print('Displays:')
    displays = data.get('displays', [])
    if displays:
        for d in displays:
            print(f'  {d.get(\"name\", \"?\")} - {d.get(\"width\", \"?\")}x{d.get(\"height\", \"?\")} @ {d.get(\"refresh_rate\", \"?\")}Hz')
    else:
        print('  No displays detected')
    print()
    
    print('Tools:')
    tools = data.get('tools', {})
    for tool, installed in tools.items():
        status = '✓' if installed else '✗'
        print(f'  {status} {tool}')
    print()
    
    print('Recommendations:')
    print(f'  Backend: {data.get(\"recommended_backend\", \"auto\")}')
    print(f'  Profile: {data.get(\"recommended_profile\", \"default\")}')
    
except Exception as e:
    print(f'Error parsing detection results: {e}')
    sys.exit(1)
"
}

cmd_system() {
    local result
    result=$(api_get "system")

    echo -e "${BOLD}System Information:${NC}"
    echo ""
    echo "$result" | python3 -c "
import sys, json
data = json.load(sys.stdin)
print(f'  Hostname:  {data.get(\"hostname\", \"?\")}')
print(f'  CPU:       {data.get(\"cpu\", \"?\")}')
print(f'  GPU:       {data.get(\"gpu\", \"?\")}')
print(f'  Wayland:   {\"✓\" if data.get(\"wayland\") else \"✗\"}')
print(f'  Hyprland:  {\"✓\" if data.get(\"hyprland\") else \"✗\"}')
print(f'  NVIDIA:    {\"✓\" if data.get(\"nvidia\") else \"✗\"}')
print(f'  CUDA:      {\"✓\" if data.get(\"cuda\") else \"✗\"}')
print()
print('  Tools:')
tools = data.get('tools', {})
for name, installed in tools.items():
    status = '✓' if installed else '✗'
    print(f'    {status} {name}')
print()
monitors = data.get('monitors', [])
print(f'  Monitors ({len(monitors)}):')
for m in monitors:
    print(f'    {m.get(\"name\",\"?\")} - {m.get(\"width\",\"?\")}x{m.get(\"height\",\"?\")} @ {m.get(\"refreshRate\",\"?\")}Hz')
" 2>/dev/null || log_error "Failed to get system info"
}

cmd_ui() {
    if ! is_daemon_running; then
        log_warn "Daemon not running, starting..."
        cmd_start
        sleep 2
    fi

    log_info "Opening WallCraft UI at ${DAEMON_URL}"

    # Try to open in browser
    if command -v xdg-open &>/dev/null; then
        xdg-open "${DAEMON_URL}" 2>/dev/null &
    elif command -v firefox &>/dev/null; then
        firefox "${DAEMON_URL}" 2>/dev/null &
    else
        echo -e "  Open ${CYAN}${DAEMON_URL}${NC} in your browser"
    fi
}

cmd_install() {
    log_info "Installing WallCraft..."
    ensure_dirs

    # Install daemon
    sudo mkdir -p "$LIB_DIR"
    sudo install -m 755 backend/wallcraft-daemon.py "$LIB_DIR/"
    sudo install -m 755 backend/smart_detector.py "$LIB_DIR/"

    # Install config if not exists
    if [ ! -f "${CONFIG_DIR}/config.toml" ]; then
        cp config/config.toml.example "${CONFIG_DIR}/config.toml"
        log_info "Config created at ${CONFIG_DIR}/config.toml"
    fi

    # Install systemd service
    local systemd_dir="${HOME}/.config/systemd/user"
    mkdir -p "$systemd_dir"
    cp systemd/wallcraft.service "$systemd_dir/"
    systemctl --user daemon-reload

    log_info "Installation complete!"
    log_info "Run 'wallcraft start' or 'systemctl --user start wallcraft'"
}

cmd_uninstall() {
    log_warn "Uninstalling WallCraft..."

    cmd_stop 2>/dev/null || true
    systemctl --user stop wallcraft.service 2>/dev/null || true
    systemctl --user disable wallcraft.service 2>/dev/null || true

    sudo rm -f /usr/local/bin/wallcraft
    sudo rm -rf "$LIB_DIR"
    rm -f "${HOME}/.config/systemd/user/wallcraft.service"
    systemctl --user daemon-reload

    log_info "WallCraft uninstalled"
    log_info "Config and cache preserved at:"
    log_info "  ${CONFIG_DIR}"
    log_info "  ${CACHE_DIR}"
}

cmd_help() {
    echo -e "${BOLD}WallCraft v${VERSION} — Wallpaper Manager for Hyprland${NC}"
    echo ""
    echo -e "${BOLD}Usage:${NC} wallcraft <command> [options]"
    echo ""
    echo -e "${BOLD}Commands:${NC}"
    echo "  start              Start the daemon"
    echo "  stop               Stop the daemon"
    echo "  restart            Restart the daemon"
    echo "  status             Show daemon status"
    echo "  monitors           List connected monitors"
    echo "  set <mon> <path>   Set wallpaper for monitor"
    echo "  next [monitor]     Switch to next wallpaper"
    echo "  list               List available wallpapers"
    echo "  detect             Run smart system detection"
    echo "  system             Show system information"
    echo "  ui                 Open web interface"
    echo "  install            Install daemon and service"
    echo "  uninstall          Remove WallCraft"
    echo "  help               Show this help"
    echo ""
    echo -e "${BOLD}Environment Variables:${NC}"
    echo "  WALLCRAFT_PORT     Daemon port (default: 9520)"
    echo "  WALLCRAFT_HOST     Daemon host (default: 127.0.0.1)"
    echo ""
    echo -e "${BOLD}Examples:${NC}"
    echo "  wallcraft start"
    echo "  wallcraft detect"
    echo "  wallcraft monitors"
    echo "  wallcraft set eDP-1 ~/Wallpapers/image.jpg"
    echo "  wallcraft next"
    echo "  wallcraft ui"
    echo ""
}

# ============================================================
# Main
# ============================================================

case "${1:-help}" in
    start)      cmd_start ;;
    stop)       cmd_stop ;;
    restart)    cmd_restart ;;
    status)     cmd_status ;;
    monitors)   cmd_monitors ;;
    set)        shift; cmd_set "$@" ;;
    next)       shift; cmd_next "$@" ;;
    list|ls)    cmd_list ;;
    detect)     cmd_detect ;;
    system|sys) cmd_system ;;
    ui|web)     cmd_ui ;;
    install)    cmd_install ;;
    uninstall)  cmd_uninstall ;;
    help|--help|-h) cmd_help ;;
    version|--version|-v) echo "WallCraft v${VERSION}" ;;
    *)
        log_error "Unknown command: $1"
        cmd_help
        exit 1
        ;;
esac
